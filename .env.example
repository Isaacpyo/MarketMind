# MarketMind environment variables.
# Copy to apps/api/.env for local API runs (docker compose already sets sensible defaults).
# Never commit real values: .env files are git-ignored.

# --- API (apps/api, Render) ------------------------------------------------------------

# development | test | production. Production refuses to start with a weak JWT_SECRET.
APP_ENV=development
# MongoDB connection string. Local: mongodb://localhost:27017
# Atlas M0: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
# Database name inside the cluster.
MONGODB_DB=marketmind
# HMAC secret for session tokens; at least 32 random characters in production.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
# Session lifetime in minutes (default 3 days).
JWT_TTL_MINUTES=4320
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
# Optional regex for extra origins, e.g. Netlify deploy previews:
# ^https://([a-z0-9-]+--)?marketmind2\.netlify\.app$
CORS_ORIGIN_REGEX=
# Seed the catalogue and purchase history on first start (idempotent).
AUTO_SEED=true
# Train a model on startup when none is stored yet.
TRAIN_ON_STARTUP=true
# Give "Try the demo" shoppers the admin role so reviewers can open the model dashboard.
DEMO_USERS_ARE_ADMIN=true
# Hours before a demo shopper and everything they created is deleted (Mongo TTL index).
DEMO_TTL_HOURS=24
# Maximum new demo shoppers per hour across all visitors (protects free-tier storage).
DEMO_GLOBAL_LIMIT_PER_HOUR=120
# Minimum seconds between admin-triggered retrains (0 disables the cooldown).
RETRAIN_COOLDOWN_SECONDS=120
# Threads implicit may use while training (1 keeps a 0.1 CPU free instance responsive).
TRAIN_THREADS=1
# Per-client request limits (per minute) for auth endpoints and tracked events.
AUTH_RATE_LIMIT_PER_MINUTE=20
EVENTS_RATE_LIMIT_PER_MINUTE=120
# Behind a reverse proxy (Render), key rate limits on the right-most X-Forwarded-For entry.
TRUST_FORWARDED_FOR=false

# --- Web (apps/web, Netlify) ------------------------------------------------------------

# Public base URL of the API, inlined into the browser bundle at build time.
# Production: https://<your-render-service>.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8000
